<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".MainActivity3">

    <!-- 상단 툴바 타이틀 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#008577"
        android:gravity="center_vertical"
        android:paddingStart="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Report 02"
            android:textColor="@android:color/white"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 스크롤 영역 -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 1. 섭씨 온도 (텍스트와 SeekBar 바로 붙이기) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvCelsius"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="섭씨온도(0.0 ℃)"
                    android:textSize="14sp" />

                <Space
                    android:layout_width="12dp"
                    android:layout_height="wrap_content" />

                <SeekBar
                    android:id="@+id/seekCelsius"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="200"
                    android:progress="100" />
            </LinearLayout>

            <!-- 2. 화씨 온도 (텍스트와 SeekBar 바로 붙이기) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvFahrenheit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="화씨온도(0.0 ℉)"
                    android:textSize="14sp" />

                <Space
                    android:layout_width="12dp"
                    android:layout_height="wrap_content" />

                <SeekBar
                    android:id="@+id/seekFahrenheit"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="200"
                    android:progress="100" />
            </LinearLayout>

            <!-- 3. 하단 영역 (왼쪽: 라디오버튼 / 오른쪽: 회색 직사각형 버튼) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- 왼쪽: 라디오버튼 그룹 -->
                <RadioGroup
                    android:id="@+id/radioGroup"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <RadioButton
                        android:id="@+id/rbCtoF"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="0dp"
                        android:minWidth="0dp"
                        android:paddingTop="2dp"
                        android:paddingBottom="2dp"
                        android:text="섭씨를 화씨로" />

                    <RadioButton
                        android:id="@+id/rbFtoC"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="-4dp"
                        android:minHeight="0dp"
                        android:minWidth="0dp"
                        android:paddingTop="2dp"
                        android:paddingBottom="2dp"
                        android:text="화씨를 섭씨로" />
                </RadioGroup>

                <!-- 💡 라디오버튼과 우측 버튼 사이의 간격 (48dp로 넓힘) -->
                <Space
                    android:layout_width="70dp"
                    android:layout_height="wrap_content" />

                <!-- 오른쪽: 사이즈가 줄어든 회색 직사각형 변환, 초기화 버튼 -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnConvert"
                        android:layout_width="0dp"
                        android:layout_height="45dp"
                        android:layout_weight="1"
                        android:background="@drawable/button"
                        android:minHeight="0dp"
                        android:minWidth="0dp"
                        android:padding="0dp"
                        android:text="변환"
                        android:textColor="#000000"
                        android:textSize="14sp" />

                    <Space
                        android:layout_width="8dp"
                        android:layout_height="wrap_content" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnReset"
                        android:layout_width="0dp"
                        android:layout_height="45dp"
                        android:layout_weight="1"
                        android:background="@drawable/button"
                        android:minHeight="0dp"
                        android:minWidth="0dp"
                        android:padding="0dp"
                        android:text="초기화"
                        android:textColor="#000000"
                        android:textSize="14sp" />
                </LinearLayout>

            </LinearLayout>

            <!-- 4. 결과 출력 텍스트 -->
            <TextView
                android:id="@+id/tvResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:textSize="16sp" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>